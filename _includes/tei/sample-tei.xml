				<title>Akiko Yosano Tankas</title>
			</titleStmt>
			<publicationStmt>
				<p/>
			</publicationStmt>
			<sourceDesc>
				<p/>
			</sourceDesc>
		</fileDesc>
	</teiHeader>

      <text xml:id="transcription">
          <body>
           
            <div facs="#f001">
				 <pb facs="#f001" />
			<lg>
              	<l>yo no chōni</l>
				<l>sasameki tsukishi</l>
				<l>hoshi no ima wo</l>
				<l>gekai no hito no</l>
				<l>bin no hotsure yo</l>
			</lg>
            </div>
           
            <div facs="#f002">
				 <pb facs="#f002" /> <!--poem2 romaji-->
			<lg>
				<l>uta ni kike na</l>
				<l>dare no no hana ni</l>
				<l>akaki inamu</l>
				<l>omomuki aru kana</l>
				<l>haru tsumi motsu ko</l>
			</lg>
            </div>

			 <div facs="#f026">
				 <pb facs="#f026" />
			<lg>
              	<l>yawahada no</l>
				<l>atsuki chishio ni</l>
				<l>fure momide</l>
				<l>sabishikarazu ya</l>
				<l>michi wo toku kimi</l>
			</lg>
            </div>
			  
          </body>
      </text>

      <text xml:id="translation1">
          <body>
            
            <div facs="#f001">
				<pb facs="#f001" />
			<lg>
				<l>bedroom curtains</l>
				<l>the lovers' talk ends</l>
				<l>now a star</l>
				<l>one person of this earth</l>
				<l>has stray hairs at the temple</l>
			</lg>
            </div>
           
            <div facs="#f002">
				 <pb facs="#f002" />
			<lg>
				<l>ask among poems</l>
				<l>who denied a bright red</l>
				<l>to field flowers</l>
				<l>a girl is so attractive</l>
				<l>with her skin of scarlet</l>
			</lg>
            </div>
			  
			<div facs="#f026">
				<pb facs="#f026" />
			<lg>
				<l>soft skin</l>
				<l>warm with heated blood</l>
				<l>not touching it</l>
				<l>on the path of virtue</l>
				<l>aren’t you lonely?</l>
			</lg>
            </div>
			  
          </body>
      </text>
	
      <text xml:id="translation2">
          <body>
            
			<div facs="#f026">
				<pb facs="#f026" />
			<lg>
				<l>Rather than trying</l>
				<l>to touch the burning passion</l>
				<l>pulsing beneath my soft</l>
				<l>pale skin, you preach mortality.</l>
				<l>Aren’t you awfully lonely?</l>
			</lg>
            </div>
			  
          </body>
      </text>
		  
      <text xml:id="translation3">
          <body>
            
			<div facs="#f026">
				<pb facs="#f026" />
			<lg>
				<l>Unable to touch</l>
				<l>the hot tide of blood</l>
				<l>beneath my tender skin.</l>
				<l>Don’t you feel lonely</l>
				<l>teacher of the Way?</l>
			</lg>
            </div>
			  
          </body>
      </text>
		  
