      <text xml:id="transcription">
          <body>
           
            <div facs="#f001">
				 <pb facs="#f001" />
			<lg>
              	<l>yo no chōni</l>
				<l>sasameki tsukishi</l>
				<l>hoshi no ima wo</l>
				<l>gekai no hito no</l>
				<l>bin no hotsure yo</l>
			</lg>
            </div>
           
            <div facs="#f002">
				 <pb facs="#f002" /> <!--poem2 romaji-->
			<lg>
				<l>uta ni kike na</l>
				<l>dare no no hana ni</l>
				<l>akaki inamu</l>
				<l>omomuki aru kana</l>
				<l>haru tsumi motsu ko</l>
			</lg>
            </div>

			 <div facs="#f026">
				 <pb facs="#f026" />
			<lg>
              	<l>yawahada no</l>
				<l>atsuki chishio ni</l>
				<l>fure momide</l>
				<l>sabishikarazu ya</l>
				<l>michi wo toku kimi</l>
			</lg>
            </div>
   		 <div facs="#f003">
				 <pb facs="#f003" />
			 <lg>
				<l>kami goshaku</l>
				<l>tokinaba mizu ni</l>
				<l>yawarakaki</l>
				<l>otome gokoro wa</l>
				<l>himete hanataji</l>
			</lg>
            </div>

		<div facs="#f004">
				 <pb facs="#f004" />
			 <lg>
				<l>chi zo moyuru</l>
				<l>kasan hitoyo no</l>
				<l>yume no yado</l>
				<l>haru wo yuku hito</l>
				<l>kami otoshime na</l>
			</lg>
            </div>

			<div facs="#f005">
				 <pb facs="#f005" />
			 <lg>
				<l>tsuakbi sore mo</l>
				<l>ume mo sanariki</l>
				<l>shirokariki</l>
				<l>waga tsumi towanu</l>
				<l>iro momo ni miru</l>
			</lg>
            </div>

			  <div facs="#f006">
				 <pb facs="#f006" />
			 <lg>
<l>sono no hatachi</l>
<l>kushi ni nagaruru</l>
<l>kurokami no</l>
<l>ogori no haru no</l>
<l>utsukushiki kana</l>
	</lg>
            </div>
			  
<div facs="#f007">
				 <pb facs="#f007" />
			 <lg>
<l>dō no kane no</l>
<l>hikuki yūbe wo</l>
<l>maegami no</l>
<l>momo no tsubomi ni</l>
<l>kyō tamae kimi</l>
	</lg>
            </div>
			  
<div facs="#f008">
				 <pb facs="#f008" />
			 <lg>
<l>murasaki ni</l>
<l>momiura niou</l>
<l>midarebako wo</l>
<l>kakusi wazurau</l>
<l>yoi no haru no kami</l>
	</lg>
            </div>
			  
				 <div facs="#f009">
				 <pb facs="#f009" />
			 <lg>
<l>enjiiro wa</l>
<l>dare ni kataran</l>
<l>chi no yuragi</l>
<l>haru no omoi no</l>
<l>sakari no inochi</l>
	</lg>
            </div>
			  
<div facs="#f010">
				 <pb facs="#f010" />
			 <lg>
<l>murasaki no</l>
<l>koki niji tokishi</l>
<l>sakazuki ni</l>
<l>utsuru haru no ko</l>
<l>mayuge kabosoki</l>
	</lg>
            </div>
			  
<div facs="#f011">
				 <pb facs="#f011" />
			 <lg>
<l>konjō wo</l>
<l>kinu ni waga naku</l>
<l>haru no kure</l>
<l>yamabukigasane</l>
<l>tomo uta nebinu</l>
	</lg>
            </div>
			  
<div facs="#f012">
				 <pb facs="#f012" />
			 <lg>
<l>mairu sake ni</l>
<l>hi akaki yoi wo</l>
<l>uta tamae</l>
<l>onna harakara</l>
<l>botan ni na naki</l>
	</lg>
            </div>
			  
<div facs="#f013">
				 <pb facs="#f013" />
			 <lg>
<l>kaidō ni </l>
<l>yōnaku tokishi</l>
<l>beni sutete</l>
<l>yūsame miyaru</l>
<l>hitomi to tayuki</l>
	</lg>
            </div>
			  
<div facs="#f014">
				 <pb facs="#f014" />
			 <lg>
<l>mizu ni neshi</l>
<l>Saga no Ōi no</l>
<l>hitoyogami</l>
<l>rogaya no suso no</l>
<l>uta hime tamae</l>
	</lg>
            </div>
			  
<div facs="#f015">
				 <pb facs="#f015" />
			 <lg>
<l>haru no kuni</l>
<l>koi no mikuni no</l>
<l>asaborake</l>
<l>shiruki wa kami ka</l>
<l>baika no abura</l>
	</lg>
            </div>
			  
<div facs="#f016">
				 <pb facs="#f016" />
			 <lg>
<l>ima wa yukan</l>
<l>saraba to iishi</l>
<l>yo no kami no</l>
<l>miisuso sawarite</l>
<l>waga kami nurenu</l>
	</lg>
            </div>
			  
<div facs="#f017">
				 <pb facs="#f017" />
			 <lg>
<l>hosoki waga</l>
<l>unaji ni amaru</l>
<l>mite nobete</l>
<l>sasae tamae-na</l>
<l>kaeru yo no kami</l>
	</lg>
            </div>
			  
				 <div facs="#f018">
				 <pb facs="#f018" />
			 <lg>
<l>kiyomizu e</l>
<l>Gion wo yogiru</l>
<l>sakura zukioyo</l>
<l>koyoi ō hito</l>
<l>mina utsukuzhiki</l>
	</lg>
            </div>
			  
<div facs="#f019">
				 <pb facs="#f019" />
			 <lg>
<l>aki no kami no</l>
<l>mikeshi yori hiku</l>
<l>shiroki niji</l>
<l>mono umou ko no</l>
<l>hitai ni kienu</l>
	</lg>
            </div>
			  
<div facs="#f020">
				 <pb facs="#f020" />
			 <lg>
<l>kyō wa nigashi</l>
<l>karu no yūbe wo</l>
<l>oku-no-in no</l>
<l>25 (nijū go) bosatsu</l>
<l>uta uketame</l>
	</lg>
            </div>
			  
				 <div facs="#f021">
				 <pb facs="#f021" />
			 <lg>
<l>yamagormori</l>
<l>kakute are na no</l>
<l>mioshie yo</l>
<l>beni tsukuru koro</l>
<l>momo no hana sakamu</l>
	</lg>
            </div>
			  
<div facs="#f022">
				 <pb facs="#f023" />
			 <lg>
<l>toki-gami ni</l>
<l>muro mutsumajino</l>
<l>yuri no kaori</l>
<l>kie wo ayabumu</l>
<l>yo no toki iro yo</l>
	</lg>
            </div>
			  
<div facs="#f024">
				 <pb facs="#f024" />
			 <lg>
<l>kumo zo aoki</l>
<l>kishi natsuhume ga</l>
<l>asa no kami</l>
<l>utsukushii kana</l>
<l>mizu ni nagaruru</l>
	</lg>
            </div>
			  
<div facs="#f025">
				 <pb facs="#f025" />
			 <lg>
<l>yo no kami no</l>
<l>asanori kaeru</l>
<l>hitsuji torae</l>
<l>chisaki makura no</l>
<l>shita ni kakusan</l>
	</lg>
            </div>
			  
<div facs="#f026">
				 <pb facs="#f026" />
			 <lg>
<l>migiwa kuru</l>
<l>ushikai otoko</l>
<l>uta are na</l>
<l>aki no mizuumi</l>
<l>amari sabishiki</l>
	</lg>
            </div>
			  
<div facs="#f027">
				 <pb facs="#f027" />
			 <lg>
<l>yawahada no</l>
<l>atsuki chishio ni</l>
<l>fure momide</l>
<l>sabishikarazu ya</l>
<l>michi wo toku kimi</l>
	</lg>
            </div>
			  
<div facs="#f028">
				 <pb facs="#f028" />
			 <lg>
<l>yurushi tamae</l>
<l>arazu ba kosono</l>
<l>ima no waga mi</l>
<l>usumurasaki no</l>
<l>sake utsukushiki</l>
	</lg>
            </div>
			  
<div facs="#f029">
				 <pb facs="#f029" />
			 <lg>
<l>wasure gataki</l>
<l>tonomini shumi wo</l>
<l>mitome mase</l>
<l>tokaji murasaki</l>
<l>sono aki no hana</l>
	</lg>
            </div>
			  
<div facs="#f030">
				 <pb facs="#f030" />
			 <lg>
<l>hito kaesazu</l>
<l>kuren no haru no</l>
<l>yoi gokochi</l>
<l>ogoto ni motasu</l>
<l>midare midaregami</l>
	</lg>
            </div>
			  
<div facs="#f031">
				 <pb facs="#f031" />
			 <lg>
<l>tamkura ni</l>
<l>bin no hitosuji</l>
<l>kireshi ne wo</l>
<l>ogoto to kikishi</l>
<l>haru no yo no yume</l>
	</lg>
            </div>
			  
<div facs="#f032">
				 <pb facs="#f032" />
			 <lg>
<l>harusame ni</l>
<l>nurete kimi koshi</l>
<l>kusa no kado yo</l>
<l>omoware gao no</l>
<l>kaidō no yū</l>
	</lg>
            </div>
			  
<div facs="#f033">
				 <pb facs="#f033" />
			 <lg>
<l>ogsua iinu</l>
<l>“yoeru naminda no</l>
<l>iro ni sakan</l>
<l>soremade kakute</l>
<l>samezarena otome”</l>
	</lg>
            </div>
			  
<div facs="#f034">
				 <pb facs="#f034" />
			 <lg>
<l>makiba idete</l>
<l>minami ni hashiru</l>
<l>mizo nagashi</l>
<l>sate mo midori no</l>
<l>no ni fusau kimi</l>
	</lg>
            </div>
			  
<div facs="#f035">
				 <pb facs="#f035" />
			 <lg>
<l>haru no oina</l>
<l>fuji ni yoritaru</l>
<l>yo no maidono</l>
<l>inarabu kora yo</l>
<l>tsuka no ma oina</l>
	</lg>
            </div>
			  
<div facs="#f036">
				 <pb facs="#f036" />
			 <lg>
<l>ame miyuru</l>
<l>ukiha shira hasu</l>
<l>eshi no kimi ni</l>
<l>kasa mairasuru</l>
<l>sanjakuu no fune</l>
	</lg>
            </div>
			  
<div facs="#f037">
				 <pb facs="#f037" />
			 <lg>
<l>misō itodo</l>
<l>shitashimi yasuki</l>
<l>natsukashiki</l>
<l>wakaba kodachi no</l>
<l>naka no Rushanabutsu</l>
	</lg>
            </div>
			  
<div facs="#f038">
				 <pb facs="#f038" />
			 <lg>
<l>sate semuna</l>
<l>takaki ni nobori</l>
<l>kimi mizu ya</l>
<l>ake no namida no</l>
<l>yōgō no ato</l>
	</lg>
            </div>
			  
<div facs="#f039">
				 <pb facs="#f039" />
			 <lg>
<l>harusame ni</l>
<l>yūbe no miya wo</l>
<l>mayoi ideshi</l>
<l>kohitsuji kimi wo</l>
<l>norowashi no ware</l>
	</lg>
            </div>
			  
<div facs="#f040">
				 <pb facs="#f040" />
			 <lg>
<l>yuami suru</l>
<l>izumi no soko no</l>
<l>sayuri bana</l>
<l>hatachi no natsu o</l>
<l>utsukyshi to minu</l>
	</lg>
            </div>
			  
<div facs="#f041">
				 <pb facs="#f041" />
			 <lg>
<l>midare gokochi</l>
<l>mayoi-gokochi zo</l>
<l>shikiri naru</l>
<l>yuri fumu kami ni</l>
<l>chichi ōi aezu</l>
	</lg>
            </div>
			  
<div facs="#f042">
				 <pb facs="#f042" />
			 <lg>
<l>kurenai no</l>
